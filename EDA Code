-----Fifth Step: Magnitude
---->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
/* 
Compare the measure values by categoties,
Help us understand importance of different 
categories
*/
---Find the total customers by countries?
select
cd.country,
count(cd.customer_key) as total_customers
from[gold].[customer_dim] as cd
group by cd.country;
---Find the total customers by gender?
select
cd.gender,
count(cd.customer_key) as total_customers
from [gold].[customer_dim] as cd
group by cd.gender
order by 
case when cd.gender = 'n/a' then 1
else 0 end,total_customers asc
---Find the total Products by categories?
select
pd.product_category,
count(pd.product_id) as total_product_by_categories
from [gold].[product_dim] as pd
group by pd.product_category
order by  
case when pd.product_category is null then 1
else 0
end,total_product_by_categories asc;
---What is the Average cost in each category?
select
pd.product_category,
avg(sf.price) as avg_cost
from [gold].[sales_fact] as sf
left join [gold].[product_dim] as pd
on sf.product_key = pd.product_key
group by pd.product_category;
---What is the Total Revenue Generated for each category?
select
pd.product_category,
format(sum(sf.sales),'c') as total_revenue
from [gold].[sales_fact] as sf
left join [gold].[product_dim] as pd
on sf.product_key = pd.product_key
group by pd.product_category;
---Find the Total Revenue is generated by each customer?
select
cd.customer_name,
cd.firstname,
cd.lastname,
SUM(sf.sales) as Total_Revenue_By_customers
from [gold].[sales_fact] as sf
Left join [gold].[customer_dim] as cd
on cd.customer_key = sf.customer_key
group by 
cd.customer_name,
cd.firstname,
cd.lastname
order by Total_Revenue_By_customers desc;
---what is the distribution of sold item accross countries?
select
cd.country,
SUM(sf.quantity) as Total_Distribution_sold_items
from [gold].[sales_fact] as sf
Left join [gold].[customer_dim] as cd
on cd.customer_key = sf.customer_key
group by 
cd.country
order by 
case when cd.country = 'n/a' then 1 else 0
end,
Total_Distribution_sold_items asc;
go
