---Sixth one : Ranking Analysis
----->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
---Which 5 Products Generate the Highest Revenue?
select*
from (
select
pd.product_name,
format(sum(sf.sales),'c') as Total_Revenue_By_Product,
DENSE_RANK() over(order by
		sum(sf.sales) desc) as Top_good_performing_Products
from [gold].[sales_fact] as sf
left join [gold].[product_dim] as pd
on sf.product_key = pd.product_key
group by pd.product_name)t
where Top_good_performing_Products<6
---->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
--- what are the 5 worst performing products in terms of sales?
select*
from (
select
pd.product_name,
format(sum(sf.sales),'c') as Total_Revenue_By_Product,
DENSE_RANK() over(order by sum(sf.sales) asc) as Top_worst_performing_Products
from [gold].[sales_fact] as sf
left join [gold].[product_dim] as pd
on sf.product_key = pd.product_key
group by pd.product_name)t
where Top_worst_performing_Products<6
