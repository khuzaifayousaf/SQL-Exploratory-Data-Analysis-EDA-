----Third Step: Date Exploration
----->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
---Identify the earliest & Latest Date (Boundaries).
---Understand the scope of data & Timespan.
---Find the date of the first & last Order
--How many Years of sales available
select
min(sf.order_date) as first_order_date,
max(sf.order_date) as last_order_date,
DATEDIFF(MONTH,min(sf.order_date),
	max(sf.order_date)) as order_range_by_month,
DATEDIFF(year,min(sf.order_date),
	max(sf.order_date)) as order_range_by_years
from [gold].[sales_fact] as sf;
go
----Find the Youngest and Oldest customer
select
min(cd.birthdate) as oldest_customers,
DATEDIFF(year,min(cd.birthdate),
		GETDATE()) as oldest_customer_age,
max(cd.birthdate) as youngest_customer,
DATEDIFF(year,max(cd.birthdate),
		GETDATE()) as youngest_customer_age
from [gold].[customer_dim] as cd;
go
----->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
---Fourth Step: Measure Exploration
----->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
/*Calculate the Key Matrics of the Business
		Highest Level of Aggregation
		Lowest Level of Details
*/
---Find the Total Sales
select
format(sum(sf.sales),'c') as total_sales
from [gold].[sales_fact] as sf;
---Find how many items are sold
select
sum(sf.quantity) as total_quantity
from [gold].[sales_fact] as sf;
---Find the average selling price
select
format(avg(sf.price),'c') as avg_selling_price
from [gold].[sales_fact] as sf;
---Find the total number of orders
select
count(sf.sales_order_number) as total_orders,
count(distinct sf.sales_order_number) as total_orders_unique
from [gold].[sales_fact] as sf
---Find the total number of Products
select
count(pd.product_number) as total_products,
count(distinct pd.product_number) as total_products_unique
from [gold].[product_dim] as pd

---Find the total number of Customers
select
count(cd.customer_key) as total_customers,
count(distinct cd.customer_key) as total_customers_unique
from [gold].[customer_dim] as cd
---Find the total number of Customers that has placed an order
select
count(distinct sf.customer_key) as customers_placed_orders
from [gold].[sales_fact] as sf;
go
